{
  "version": "1.0",
  "sheet": "raw",
  "filename": "{date}_{device}_Cgm_Report.xlsx",
  "headers": ["Test Nr.", "Test Name", "Unit", "Lowlim", "Uplim"],
  "site_headers": ["Mean", "StdDev", "min", "max", "cg*", "ExecCount", "FailCount"],
